{
  "name": "copilot-debugger",
  "version": "1.3.0",
  "private": false,
  "description": "Copilot Debugger is a local viewer for Copilot Agent Host sessions, context, tools, agents, skills, tokens, and costs.",
  "type": "module",
  "author": "Miroslav Holec",
  "bin": {
    "copilot-debugger": "./dist/server/cli.js"
  },
  "files": [
    "dist",
    "!dist/server/**/*.test.js",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta npm:dev:api npm:dev:web",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite --host 127.0.0.1",
    "stop": "node scripts/stop-server.mjs",
    "clean": "node -e \"fs.rmSync('dist', { recursive: true, force: true })\"",
    "prepack": "npm run build",
    "build": "npm run clean && npm run build:client && npm run build:server",
    "build:client": "tsc -p tsconfig.app.json --noEmit && vite build",
    "build:server": "tsc -p server/tsconfig.json",
    "test": "tsx --test server/sources/*.test.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "start": "node dist/server/index.js"
  },
  "engines": {
    "node": ">=20.9"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mirekholec/copilot-debugger.git"
  },
  "homepage": "https://github.com/mirekholec/copilot-debugger#readme",
  "bugs": {
    "url": "https://github.com/mirekholec/copilot-debugger/issues"
  },
  "license": "MIT",
  "keywords": [
    "copilot",
    "vscode",
    "debug",
    "sessions",
    "viewer"
  ],
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "chokidar": "^4.0.3",
    "express": "^4.21.2",
    "fast-glob": "^3.3.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.10",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.2",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.6"
  }
}
